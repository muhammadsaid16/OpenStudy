# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local database files (don't commit)
*.db
*.db-journal
dev.db*
*.sqlite
*.sqlite3

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel
.env*

# local audit artifacts
_e2e/screenshots-v2/
_e2e/montages-v2/
_e2e/audit-v2.json

# AutoClaw/ZCode scratch
.openclaw/

# Midscene E2E run artifacts (logs + HTML reports, regenerated every run)
midscene_run/

# Playwright
playwright-report/
test-results/
