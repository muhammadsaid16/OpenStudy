# Copy to .env.local and fill in. Every var below is read by the app; all are
# optional in the sense that the app still runs without them, but each one
# disables the feature noted beside it.
#
# Server-only keys. Never prefix these with NEXT_PUBLIC_ — that inlines them
# into the client bundle and exposes them to every visitor.

# Google Gemini — primary provider for /api/ai/explain, /api/ai/explain/stream,
# /api/ai/generate-cards and /api/ai/analyze-image.
GEMINI_API_KEY=

# Groq — the fallback used when Gemini is rate-limited or out of credits.
# Without it, those same routes fail outright once Gemini is exhausted.
GROQ_API_KEY=

# ─── Spotify ──────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard and add the redirect
# URI <your-origin>/callback (e.g. http://localhost:3000/callback).

# Public OAuth client id (PKCE, no secret). Inlined into the client bundle on
# purpose — this one is safe to expose.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Server-side pair, used by /api/spotify/search and /api/spotify/playlist for
# the Client Credentials flow (public playlist inspection). Without it those
# routes fall back to iTunes previews and public-embed metadata only.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
